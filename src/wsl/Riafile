cmd "update-ria", opt: "[source=../tools/ria.dist.rb]" do |source:| # 生成済み dist で実行中の ria を更新。入口の参照先は維持
  require "tempfile"
  source = File.expand_path(source)
  content = File.binread(source)
  raise "ria dist の生成物ではありません: #{source}" unless content.lines.first(5).any? { _1.start_with?("# ria.dist.rb - generated by ria dist;") }
  target = File.realpath($PROGRAM_NAME)
  raise "ria 本体から実行してください" unless File.read(target).include?("def riafile2cmd(")
  raise "更新元と配置先が同じです: #{target}" if File.identical?(source, target)
  puts "ria 更新: #{source} -> #{target}（既存ランチャーの参照先を維持）"
  Tempfile.create(["ria-update-", ".rb"], File.dirname(target)) do |file|
    file.binmode
    file.write(content)
    file.flush
    sh RbConfig.ruby, "--disable-gems", "-c", file.path
    File.chmod(File.stat(target).mode & 0o777, file.path)
    file.close
    File.rename(file.path, target)
  end
end

cmd "status" do # WSL / systemd / fstab / Incus / WAW 資源と旧未完了記録を読み取り専用で表示
  raise "WSL 上で実行してください" unless ENV["WSL_DISTRO_NAME"]
  $stdout.sync = true
  root = File.expand_path("~/.waw")
  failed = false
  puts "WSL: #{ENV.fetch('WSL_DISTRO_NAME')} / user=#{ENV['USER']} / WAW_HOME=#{root}"
  puts "\n=== systemd / Incus units ==="
  code = sh "bash", "-c", <<~'SH', abort: false
    init=$(ps -p 1 -o comm=) || exit 1
    echo "PID 1: $init"
    if [ "$init" != systemd ]; then
      echo 'systemd: 利用不可。/etc/wsl.conf の [boot] systemd 設定を確認してください（変更していません）'
      exit 1
    fi
    result=0
    systemctl is-system-running || result=1
    systemctl show incus.service incus.socket --no-pager \
      -p Id -p LoadState -p ActiveState -p SubState -p UnitFileState || result=1
    systemctl --failed --no-pager --plain || result=1
    exit "$result"
  SH
  failed = true unless code == 0
  puts "\n=== /etc/fstab（静的検査のみ・mount はしません） ==="
  failed = true unless sh("bash", "-c", "findmnt --verify --verbose", abort: false) == 0

  puts "\n=== Incus daemon（local: への実際の接続） ==="
  reachable = sh("bash", "-c", "incus info local: >/dev/null", abort: false) == 0
  if reachable
    puts "Incus daemon: OK"
    [["instances", "incus list local: --format=json 2>&1"],
     ["storage", "incus storage list local: --format=json 2>&1"]].each do |kind, command|
      puts "\n=== #{kind} ==="
      output = `#{command}`
      unless $?.success?
        puts "#{kind}: UNKNOWN（一覧取得失敗。不在とは判定しません）\n#{output.strip}"
        failed = true
        next
      end
      begin
        entries = JSON.parse(output)
        raise "一覧が配列ではありません" unless entries.is_a?(Array)
        if kind == "instances"
          targets = entries.select { _1['name'] == 'waw' || _1.fetch('config', {})['user.waw.owner'] == 'waw-incus-v1' }
          puts "base waw: ABSENT" unless targets.any? { _1['name'] == 'waw' }
          targets.sort_by { _1.fetch('name') }.each do |entry|
            config = entry.fetch('expanded_config', entry.fetch('config', {}))
            owned = config['user.waw.owner'] == 'waw-incus-v1' && config['user.waw.home'] == root
            puts "#{entry.fetch('name')}: #{entry.fetch('status')} / #{entry.fetch('type')} / ownership=#{owned ? 'WAW' : 'UNKNOWN'} / parent=#{config['user.waw.parent'] || '-'} / project=#{config['user.waw.project'] || '-'}"
            failed = true unless owned
          end
        else
          pool = entries.find { _1['name'] == 'images' }
          if pool
            config = pool.fetch('config', {})
            owned = config['user.waw.owner'] == 'waw-incus-v1'
            puts "images: #{pool.fetch('status')} / driver=#{pool.fetch('driver')} / size=#{config['size'] || '-'} / ownership=#{owned ? 'WAW' : 'UNKNOWN'}"
            failed = true unless owned && pool['driver'] == 'btrfs' && pool['status'] == 'Created'
          else
            puts "images: ABSENT"
          end
        end
      rescue JSON::ParserError, KeyError, TypeError, NoMethodError, RuntimeError => error
        puts "#{kind}: UNKNOWN（一覧を解釈できません: #{error.message}）"
        failed = true
      end
    end
  else
    failed = true
    puts "Incus daemon: UNREACHABLE（停止・権限・socket 等は上の診断を確認）"
    puts "instances / storage: UNKNOWN（取得していません。不在とは判定しません）"
    puts "確認: systemctl status incus.service incus.socket --no-pager"
    puts "確認: journalctl -b -u incus.service -u incus.socket --no-pager"
    puts "確認: id（incus-admin の権限も確認。付与・サービス起動は行っていません）"
  end

  puts "\n=== 旧 project 登録 / 未完了操作（診断のみ・再開処理は撤去済み） ==="
  paths = Dir.glob("#{root}/projects/*.json").sort
  puts "projects: #{paths.size}（登録記録のみ。Git 同期・guest 内検査はしません）"
  paths.each do |path|
    begin
      entry = JSON.parse(File.read(path))
      puts "#{entry.fetch('name')}: /waw/#{entry.fetch('directory', entry['name'])} <- #{entry.fetch('source')} / owner=#{entry.fetch('owner')}"
    rescue SystemCallError, JSON::ParserError, KeyError, TypeError => error
      puts "project: UNKNOWN #{path}（#{error.message}）"
      failed = true
    end
  end
  pending = "#{root}/unfinished.json"
  begin
    if File.exist?(pending) || File.symlink?(pending)
      puts "unfinished: #{pending}\n#{JSON.pretty_generate(JSON.parse(File.read(pending)))}"
    else
      puts "unfinished: NONE"
    end
  rescue SystemCallError, JSON::ParserError => error
    puts "unfinished: UNKNOWN（#{error.message}）"
    failed = true
  end
  puts "\nstatus: #{failed ? '問題あり / 取得不能あり' : '取得完了'}（読み取りのみ。起動・修復・同期は行っていません）"
  exit 1 if failed
end

cmd "bootstrap", opt: "[size=8GiB] [image=images:ubuntu/24.04]" do |size:, image:| # ローカル取得物と生成済み ria dist から親を初期構築。失敗資源は保持
  require "rbconfig"
  raise "WSL Ubuntu の一般ユーザーで実行してください" unless ENV["WSL_DISTRO_NAME"] && Process.uid != 0
  raise "Ubuntu が必要です" unless File.read("/etc/os-release").match?(/^ID=ubuntu$/)
  raise "size は例 8GiB / 20GiB" unless size.match?(/\A[1-9][0-9]*[MG]iB\z/)
  raise "不正な image" unless image.match?(/\A[a-zA-Z0-9][a-zA-Z0-9:._\/-]*\z/)
  dist = File.realpath($PROGRAM_NAME)
  content = File.binread(dist)
  raise "生成済み ria.dist.rb で実行してください（klib は配置しません）" unless content.lines.first(5).any? { _1.start_with?("# ria.dist.rb - generated by ria dist;") }
  sh "bash", "-eu", "-c", <<~'SH'
    test "$(ps -p 1 -o comm=)" = systemd || {
      echo '/etc/wsl.conf の [boot] systemd=true を確認し、承認した上で Windows から wsl --shutdown 後に再実行してください。変更していません。' >&2
      exit 1
    }
  SH
  puts "不足する WSL ホストツールを apt で導入し、専用 ria 入口、Incus images pool / wawbr0 / waw-root volume / 親 waw を準備します。"
  puts "親には Ubuntu の apt ツール・mise・Node・公式 Pi を導入します（外部ダウンロードあり）。既存ツールの無条件更新・資源削除はしません。"
  print "続行するなら yes: "; $stdout.flush
  raise "変更せず停止しました" unless $stdin.gets&.strip == "yes"
  # install? は子タスク終了時に導入を完了する。ria の PATH 配置前なので dist を直接呼ぶ。
  sh RbConfig.ruby, "--disable-gems", dist, "--riafile", "Riafile", "setup"
  sh "bash", "-eu", "-c", <<~'SH'
    incus info local: >/dev/null || {
      echo 'Incus が利用できません。service/socket とユーザー権限を確認してください。incus-admin はホスト root 相当です。付与・サービス設定は行っていません。' >&2
      exit 1
    }
  SH
  home = File.expand_path("~/.waw")
  runtime = File.join(home, "runtime")
  raise "symlink は使用しません: #{runtime}" if File.symlink?(runtime)
  FileUtils.mkdir_p(runtime, mode: 0o755)
  stat = File.stat(runtime)
  raise "runtime の所有者・権限が不正です" unless stat.uid == Process.uid && (stat.mode & 0o022).zero?
  installed = File.join(runtime, "ria.dist.rb")
  ria = File.expand_path("~/.local/bin/ria")
  launcher = "#!/bin/sh\n# WAW bootstrap ria v1\nexec #{Shellwords.escape(RbConfig.ruby)} --disable-gems #{Shellwords.escape(installed)} \"$@\"\n"
  { installed => content, ria => launcher }.each do |path, data|
    raise "既存ファイルは変更しません: #{path}" if File.symlink?(path) || (File.exist?(path) && (!File.file?(path) || File.binread(path) != data))
  end
  FileUtils.mkdir_p(File.dirname(ria))
  File.binwrite(installed, content) unless File.exist?(installed)
  File.binwrite(ria, launcher) unless File.exist?(ria)
  File.chmod(0o755, ria)
  ENV["PATH"] = "#{File.dirname(ria)}:#{ENV.fetch('PATH')}"
  sh "ria", "--riafile", "Riafile", "init-storage", "size=#{size}"
  # 全一覧の取得失敗を「不存在」にしない。未知の同名資源は採用しない。
  listing = `incus list local: --format=json`
  raise "instance 一覧取得失敗" unless $?.success?
  parent = JSON.parse(listing).find { _1.fetch("name") == "waw" }
  if parent
    config = parent.fetch("expanded_config")
    raise "既存 waw は bootstrap 完了済みの WAW 親ではありません。上書き・再開はしません" unless parent["type"] == "container" && config.values_at("user.waw.owner", "user.waw.home", "security.privileged", "user.waw.bootstrap") == ["waw-incus-v1", home, "false", "ready"]
  else
    networks = `incus network list local: --format=json`
    raise "network 一覧取得失敗" unless $?.success?
    network = JSON.parse(networks).find { _1.fetch("name") == "wawbr0" }
    if network
      raise "未知・不調の wawbr0 は変更しません" unless network["type"] == "bridge" && network["managed"] == true && network["status"] == "Created" && network.fetch("config")["user.waw.owner"] == "waw-incus-v1"
    else
      sh "incus", "network", "create", "local:wawbr0", "--type=bridge", "ipv4.address=auto", "ipv4.nat=true", "ipv6.address=none", "user.waw.owner=waw-incus-v1"
    end
    volumes = `incus storage volume list local:images --format=json`
    raise "volume 一覧取得失敗" unless $?.success?
    volume = JSON.parse(volumes).find { _1.fetch("name") == "waw-root" && _1["type"] == "custom" }
    if volume
      raise "未知の共有 root volume は採用しません" unless volume["content_type"] == "filesystem" && volume.fetch("config").values_at("user.waw.owner", "user.waw.home") == ["waw-incus-v1", home]
    else
      sh "incus", "storage", "volume", "create", "local:images", "waw-root", "user.waw.owner=waw-incus-v1", "user.waw.home=#{home}"
    end
    # default profile の未知の device/config を継承しない。
    sh "incus", "init", image, "local:waw", "--no-profiles", "--storage", "images", "--network", "wawbr0",
       "--config", "security.privileged=false", "--config", "raw.idmap=uid #{Process.uid} 0\ngid #{Process.gid} 0",
       "--config", "user.waw.owner=waw-incus-v1", "--config", "user.waw.home=#{home}", "--config", "user.waw.bootstrap=pending"
    sh "incus", "config", "device", "add", "local:waw", "waw-root", "disk", "pool=images", "source=waw-root", "path=/root"
    sh "incus", "start", "local:waw"
    sh "incus", "exec", "local:waw", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH'
      . /etc/os-release; test "$ID" = ubuntu
      apt-get update
      apt-get install -y git ruby curl ca-certificates socat
      mkdir -p /opt/waw/runtime /usr/local/bin /waw/waw
    SH
    sh "incus", "file", "push", installed, "local:waw/opt/waw/runtime/ria.dist.rb"
    sh "incus", "exec", "local:waw", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH'
      printf '%s\n' '#!/bin/sh' 'exec ruby --disable-gems /opt/waw/runtime/ria.dist.rb "$@"' > /usr/local/bin/ria
      chmod +x /usr/local/bin/ria
    SH
    # 取得物の内容をそのまま初期 repo にする。外部 remote の登録・push は行わない。
    sh "bash", "-euo", "pipefail", "-c", <<~'SH'
      tar -C ../.. -cf - src |
        incus exec local:waw -- bash -eu -c 'tar -C /waw/waw -xf -'
    SH
    sh "incus", "exec", "local:waw", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH'
      git -C /waw/waw init --initial-branch=main
      git -C /waw/waw add -A
      git -C /waw/waw -c user.name=WAW -c user.email=waw@localhost commit -m 'WAW initial local installation'
      ria --riafile /waw/waw/src/incus/Riafile setup
    SH
    sh "incus", "config", "set", "local:waw", "user.waw.bootstrap=ready"
  end
  sh "incus", "start", "local:waw" if parent && parent["status"] == "Stopped"
  sh "ria", "--riafile", "Riafile", "install"
  puts "導入処理完了。Windows のターミナルで waw bash waw を実行してください。新規 WSL 実機での確認は別途必要です。"
end

cmd "install" do # 作成済み親のコードを公開し、再実行で mount 起動設定・WSL 入口の不足を埋める
  raise "WSL 上の一般ユーザーで実行してください" unless ENV["WSL_DISTRO_NAME"] && Process.uid != 0
  sh "ria", "--riafile", "Riafile", "setup"
  home = File.expand_path("~/.waw")
  target = File.join(home, "waw")
  listing = `incus query local:/1.0/instances/waw`
  raise "親 waw の取得失敗。親を準備してから install を再実行してください" unless $?.success?
  parent = JSON.parse(listing)
  config = parent.fetch("expanded_config")
  raise "WAW 所有の非特権親 container ではありません" unless parent["type"] == "container" && config.values_at("user.waw.owner", "user.waw.home", "security.privileged") == ["waw-incus-v1", home, "false"]
  roots = parent.fetch("expanded_devices").values.select { _1["type"] == "disk" && _1["path"] == "/" }
  raise "親の root disk が一意ではありません" unless roots.size == 1
  pool = roots.first.fetch("pool")
  raise "不正な pool 名" unless pool.match?(/\A[a-zA-Z0-9-]+\z/)
  info = `incus query local:/1.0/storage-pools/#{Shellwords.escape(pool)}`
  raise "pool の取得失敗" unless $?.success?
  storage = JSON.parse(info)
  raise "WAW 所有の利用可能な Btrfs pool が必要です" unless storage["driver"] == "btrfs" && storage["status"] == "Created" && storage.fetch("config")["user.waw.owner"] == "waw-incus-v1"
  source = "/var/lib/incus/storage-pools/#{pool}/containers/waw/rootfs/waw/waw"
  raise "親コードがホストから参照できません: #{source}。親を起動して再実行してください" unless File.file?("#{source}/src/wsl/cli/Riafile") && File.file?("#{source}/src/incus/Riafile")
  raise "symlink の公開先は変更しません: #{target}" if File.symlink?(target)
  mounts = `findmnt --json --mountpoint #{Shellwords.escape(target)} --output TARGET,SOURCE`
  mount_status = $?.exitstatus
  raise "mount 一覧取得失敗" unless [0, 1].include?(mount_status)
  mounted = mount_status == 0
  if mounted
    JSON.parse(mounts).fetch("filesystems") # 取得に成功しても不正な応答は不在とみなさない
    raise "別の実体を指す mount です。利用中の mount は解除しません: #{target}" unless File.identical?(source, target)
  elsif File.exist?(target)
    raise "空でない公開先は自動移動しません。必要な履歴・差分を実行経路外へ退避して再実行してください: #{target}" unless File.directory?(target) && Dir.empty?(target)
  end
  if File.exist?(target)
    stat = File.lstat(target)
    raise "公開先の所有者・権限が不正です" unless stat.uid == Process.uid && (stat.mode & 0o022).zero?
  end
  # 起動シェルが rootfs を確認してから要求する mount。boot 時の pool 未準備と競合させない。
  unit_name = `systemd-escape --path --suffix=mount #{Shellwords.escape(target)}`.strip
  raise "mount unit 名の取得失敗" unless $?.success? && unit_name.end_with?(".mount") && !unit_name.include?("/")
  unit_path = "/etc/systemd/system/#{unit_name}"
  marker = "# WAW managed parent-code mount v1: #{home}\n"
  # What/Where はシェル引数ではない。引用符で囲むと引用符自体がパスに残る。
  quote = ->(value) { value.gsub(/[%\s\\"#;]/) { |char| char == "%" ? "%%" : format('\\x%02x', char.ord) } }
  unit = <<~UNIT
    #{marker.chomp}
    # Parent UUID: #{config.fetch('volatile.uuid')}
    [Unit]
    Description=WAW parent code publication
    DefaultDependencies=no
    Requires=incus.service
    After=incus.service
    Conflicts=umount.target
    Before=umount.target

    [Mount]
    What=#{quote.call(source)}
    Where=#{quote.call(target)}
    Type=none
    Options=bind

  UNIT
  if File.symlink?(unit_path) || (File.exist?(unit_path) && !File.read(unit_path).start_with?(marker))
    raise "未知の unit は上書きしません: #{unit_path}"
  end
  enabled = `systemctl is-enabled #{Shellwords.escape(unit_name)} 2>/dev/null`.strip
  enable_status = $?.exitstatus
  raise "unit 状態の取得失敗: #{enabled}" unless [0, 1, 4].include?(enable_status)
  user = Etc.getpwuid(Process.uid).name
  raise "cmd に使用できないユーザー名" unless user.match?(/\A[a-zA-Z0-9_.-]+\z/)
  %w[/usr/bin/nsenter /usr/sbin/runuser].each do |path|
    raise "Windows 入口に必要なコマンドがありません: #{path}" unless File.executable?(path)
  end
  policy_path = "/usr/share/polkit-1/rules.d/49-waw-mount-#{Process.uid}.rules"
  policy_marker = "// WAW managed mount permission v1: #{home}\n"
  policy = policy_marker + <<~JS
    polkit.addRule(function(action, subject) {
      if (subject.user === #{user.to_json} &&
          action.id === "org.freedesktop.systemd1.manage-units" &&
          action.lookup("unit") === #{unit_name.to_json} &&
          action.lookup("verb") === "start") {
        return polkit.Result.YES;
      }
    });
  JS
  raise "未知の権限設定は上書きしません: #{policy_path}" if File.symlink?(policy_path) || (File.exist?(policy_path) && !File.read(policy_path).start_with?(policy_marker))
  policy_changed = !File.file?(policy_path) || File.read(policy_path) != policy
  require "rbconfig"
  host_ruby = RbConfig.ruby
  ria_command = `sh -c 'command -v ria'`.strip
  raise "WSL の ria 入口が必要です" unless $?.success? && File.executable?(ria_command)
  launcher_path = File.expand_path("~/.local/bin/waw")
  launcher_marker = "#!/bin/sh\n# WAW bootloader v1\n"
  if File.symlink?(launcher_path) || (File.exist?(launcher_path) && !File.read(launcher_path).start_with?(launcher_marker, "#!/bin/sh\n# Generated by ria --riafile2cmd\n"))
    raise "未知の waw 入口は上書きしません: #{launcher_path}"
  end
  changed = !File.file?(unit_path) || File.read(unit_path) != unit
  puts "親コード: #{source} -> #{target}"
  if changed || policy_changed || enabled == "enabled" || !mounted
    raise "WSL の対話端末で ria install を再実行してください（mount 設定の確認・sudo が必要）" unless $stdin.tty?
    puts "#{unit_path} を必要時起動の mount に設定します。旧 boot 時の有効化は解除します。親の停止・再作成はしません。"
    puts "#{policy_path}: #{user} に、この mount unit の start 操作だけを許可します。"
    print "続行するなら yes: "; $stdout.flush
    raise "設定を変更せず停止しました" unless $stdin.gets&.strip == "yes"
    sh "sudo", "-v"
    Dir.mkdir(target, 0o755) unless File.exist?(target)
    if policy_changed
      require "tempfile"
      Tempfile.create("waw-polkit") do |file|
        file.write(policy); file.flush
        sh "sudo", "install", "-m", "0644", file.path, policy_path
      end
    end
    if changed
      require "tempfile"
      Tempfile.create("waw-mount") do |file|
        file.write(unit); file.flush
        sh "sudo", "install", "-m", "0644", file.path, unit_path
      end
      sh "sudo", "systemctl", "daemon-reload"
    end
    sh "sudo", "systemctl", "disable", unit_name if enabled == "enabled"
    # 稼働中の正しい bind は再 mount しない。
    sh "sudo", "systemctl", "start", unit_name unless mounted
  end
  raise "公開先が親コードと一致しません" unless File.identical?(source, target)
  launcher = launcher_marker + <<~SH
    set -eu
    fail() { printf 'waw: %s\\n' "$*" >&2; exit 1; }
    source=#{Shellwords.escape(source)}
    target=#{Shellwords.escape(target)}
    unit=#{Shellwords.escape(unit_name)}
    incus admin waitready --timeout=30 || fail 'Incus daemon が利用できません'
    metadata=$(incus query local:/1.0/instances/waw) || fail '親 waw の取得失敗'
    printf '%s' "$metadata" | python3 -c #{Shellwords.escape(<<~PY)} || fail '親の所有印・UUID・pool が install 時と一致しません。再設定が必要です'
      import json,sys
      p=json.load(sys.stdin)
      c=p['expanded_config']
      assert p['type']=='container'
      assert [c.get(k) for k in ['user.waw.owner','user.waw.home','security.privileged','volatile.uuid']]==#{["waw-incus-v1", home, "false", config.fetch("volatile.uuid")].to_json}
      roots=[d for d in p['expanded_devices'].values() if d.get('type')=='disk' and d.get('path')=='/']
      assert len(roots)==1 and roots[0]['pool']==#{pool.to_json}
    PY
    test -r "$source/src/wsl/cli/Riafile" || fail "親 rootfs のコードが見えません: $source。親・pool の状態を確認してください"
    if ! mountpoint -q "$target"; then
      systemctl --no-ask-password start "$unit" || fail "公開 mount の復旧失敗: systemctl status $unit を確認してください"
    fi
    mountpoint -q "$target" && test "$source" -ef "$target" || fail '公開 mount が親コードと一致しません。自動解除はしません'
    RIA_PWD=${WAW_WINDOWS_CWD:-${RIA_PWD:-$PWD}}
    export RIA_PWD
    unset WAW_WINDOWS_CWD
    cd "$target/src/wsl"
    ruby=#{Shellwords.escape(host_ruby)}
    test -x "$ruby" || fail 'install 時の Ruby が利用できません。install を再実行してください'
    PATH="$(dirname "$ruby")":#{Shellwords.escape(File.dirname(ria_command))}:"$HOME/.local/bin:$PATH"
    export PATH
    exec "$ruby" --disable-gems #{Shellwords.escape(File.realpath($PROGRAM_NAME))} --riafile "$target/src/wsl/cli/Riafile" "$@"
  SH
  FileUtils.mkdir_p(File.dirname(launcher_path))
  File.write(launcher_path, launcher) unless File.file?(launcher_path) && File.read(launcher_path) == launcher
  File.chmod(0o755, launcher_path)
  # Windows には Ruby も UNC 上のコードも不要。cwd は WSLENV の path 変換で渡す。
  distro = ENV.fetch("WSL_DISTRO_NAME")
  raise "cmd に使用できない distro 名" unless distro.match?(/\A[a-zA-Z0-9_.-]+\z/)
  raise "cmd に使用できない launcher path" if launcher_path.match?(/[\r\n"%]/)
  # WSL の通常起動と systemd は別 mount namespace になり得る。
  # mount unit と同じ namespace に入り、WAW のコードを読む前に一般ユーザーへ戻す。
  # sudo 設定や別 namespace への追加 bind は不要。runuser は login shell を使わず cwd/env を渡す。
  windows_launcher = <<~BAT.gsub("\n", "\r\n")
    @echo off
    rem WAW WSL bootloader v1
    setlocal DisableDelayedExpansion
    set "WAW_WINDOWS_CWD=%CD%"
    set "WSLENV=%WSLENV%:WAW_WINDOWS_CWD/p"
    wsl.exe -d #{distro} --user root --exec /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/sbin/runuser -u #{user} -- "#{launcher_path}" %*
    exit /b %errorlevel%
  BAT
  ps = <<~PS
    $ErrorActionPreference = 'Stop'
    $path = Join-Path $env:LOCALAPPDATA 'Microsoft/WindowsApps/waw.cmd'
    if (Test-Path -LiteralPath $path) {
      $old = [IO.File]::ReadAllText($path)
      if (!$old.StartsWith("@echo off`r`nrem WAW WSL bootloader v1`r`n") -and !$old.StartsWith("@echo off`r`nrem Generated by ria --riafile2cmd`r`n")) {
        throw "Unknown launcher; refusing overwrite: $path"
      }
    }
    $content = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('#{[windows_launcher].pack("m0")}'))
    if (!(Test-Path -LiteralPath $path) -or [IO.File]::ReadAllText($path) -cne $content) {
      [IO.File]::WriteAllText($path, $content, [Text.UTF8Encoding]::new($false))
    }
    Write-Output "Windows launcher: $path"
  PS
  sh "powershell.exe", "-NoProfile", "-NonInteractive", "-EncodedCommand", [ps.encode("UTF-16LE")].pack("m0")
  puts "親コード公開・WSL/Windows ブートローダーの設定完了。install は再実行できます。"
end

cmd "setup" do # 不足ホストツールと ~/.waw/run を準備。開発ツールは Ubuntu guest の共有 /root で管理
  raise "WSL 上で実行してください" unless ENV["WSL_DISTRO_NAME"]
  root = File.expand_path("~/.waw")
  [root, "#{root}/run"].each do |dir|
    begin
      Dir.mkdir(dir, 0o755)
    rescue Errno::EEXIST
      # 再実行では既存の所有者・権限を変更しない。
    end
    stat = File.lstat(dir)
    raise "#{dir} は実行ユーザー所有の安全な directory ではありません。変更していません" unless stat.directory? && stat.uid == Process.uid && (stat.mode & 0o022).zero?
  end
  "git".install?(apt: "git")
  "incus".install?(apt: "incus")
  "python3".install?(apt: "python3")
  "dnsmasq".install?(apt: "dnsmasq-base")
  "btrfs".install?(apt: "btrfs-progs")
  "findmnt".install?(apt: "util-linux")
  "pkaction".install?(apt: "polkitd")
  "curl".install?(apt: "curl")
  "socat".install?(apt: "socat")
  "update-ca-certificates".install?(apt: "ca-certificates")
end

cmd "init-storage", opt: "[size=8GiB]" do |size:| # Incus 管理の images pool を準備。既存 pool の拡張・format・自動採用はしない
  raise "WSL 上で実行してください" unless ENV["WSL_DISTRO_NAME"]
  raise "size は例 8GiB / 20GiB" unless size.match?(/\A[1-9][0-9]*[MG]iB\z/)
  sh "ria", "--riafile", "Riafile", "setup"
  root = File.expand_path("~/.waw")
  raise "symlink は使用しません" if [root, "#{root}/lock"].any? { File.symlink?(_1) }
  FileUtils.mkdir_p(root)
  File.open("#{root}/lock", "a") do |lock|
    raise "別の waw が処理中です" unless lock.flock(File::LOCK_EX | File::LOCK_NB)
    pools = `incus storage list local: --format=json`
    raise "Incus pool 一覧を取得できません。incus storage list local: を確認してください" unless $?.success?
    pool = JSON.parse(pools).find { _1.fetch("name") == "images" }
    if pool
      raise "既存 images pool は WAW 所有の Btrfs ではありません。変更していません" unless pool["driver"] == "btrfs" && pool.fetch("config", {})["user.waw.owner"] == "waw-incus-v1"
      raise "images pool が利用可能ではありません: #{pool['status']}" unless pool["status"] == "Created"
    else
      sh "incus", "storage", "create", "local:images", "btrfs", "size=#{size}", "user.waw.owner=waw-incus-v1"
    end
    puts "Btrfs pool ready: local:images（既存 pool の容量は変更しません）"
  end
end

cmd "local", opt: "[instance=waw] [cwd=/waw/waw]" do |operation, *args, instance:, cwd:| # 通常 CLI の bare・remote 管理なし経路
  raise "WSL 上で実行してください" unless ENV["WSL_DISTRO_NAME"]
  args = JSON.parse(ENV.fetch('WAW_TEMP_ARGS')) if operation == 'temp' && ENV.key?('WAW_TEMP_ARGS')
  listing = `incus list local: --format=json`
  raise "instance 一覧取得失敗" unless $?.success?
  instances = JSON.parse(listing)
  owned = instances.select do |row|
    row["type"] == "container" && row.fetch("expanded_config", {}).values_at("user.waw.owner", "user.waw.home", "security.privileged") == ["waw-incus-v1", File.expand_path("~/.waw"), "false"]
  end
  if operation == "list"
    raise "list に引数はありません" unless args.empty?
    puts "ID\tSTATE\tKIND\tPARENT"
    owned.each do |row|
      config = row.fetch("expanded_config")
      kind = row['name'] == 'waw' ? 'root' : (config['user.waw.temp'] == 'true' ? 'temp (残存/実行中)' : 'retained')
      puts [row.fetch('name'), row.fetch('status'), kind, config['user.waw.parent'] || '-'].join("\t")
    end
    next
  end
  instance = args.shift || instance if operation == "drop"
  select = operation == "bash" && instance == "waw" && args.empty? && ENV["WAW_LOCAL_SELECT"] != "0"
  instance = args.shift || instance if operation == "bash"
  if select
    # 番号選択は stdin で操作可能。既存 UI / PTY の再実装はしない。
    owned.each_with_index { |row, i| puts "#{i + 1}: #{row.fetch('name')} (#{row.fetch('status')})" }
    print "環境 [waw]: "; $stdout.flush
    # Bash read は後続の入室入力を先読みしない（Ruby gets の buffer を子へ渡さない）。
    selected = `bash -c 'IFS= read -r id; printf "%s" "$id"'`.strip
    raise "選択番号が範囲外です" if selected.match?(/\A\d+\z/) && !(1..owned.size).cover?(Integer(selected))
    instance = selected.empty? ? "waw" : (selected.match?(/\A\d+\z/) ? owned.fetch(Integer(selected).pred).fetch("name") : selected)
  end
  target = owned.find { _1["name"] == instance }
  raise "WAW 所有の環境ではありません: #{instance}" unless target
  pool = target.fetch("expanded_devices").fetch("root").fetch("pool")
  raise "不正な pool / instance 名" unless [pool, instance].all? { _1.match?(/\A[a-zA-Z0-9-]+\z/) }
  state = { "rootfs" => "/var/lib/incus/storage-pools/#{pool}/containers/#{instance}/rootfs" }

  if operation == "herdr"
    raise "herdr [instance=ID] [cwd=/path]" unless args.empty?
    sh "incus", "start", "local:#{instance}" if target["status"] == "Stopped"
    sh "incus", "exec", "local:#{instance}", "--disable-stdin", "--cwd", cwd, "--", "env",
       "PATH=/opt/waw/bin:/root/.local/share/mise/shims:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
       "herdr", "tab", "create", "--cwd", cwd
    next
  end

  if operation == "bash"
    sh "incus", "start", "local:#{instance}" if target["status"] == "Stopped"
    # 生成物は子のローカル FS。共有 /root の復旧用 waw は変更しない。
    sh "incus", "exec", "local:#{instance}", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH'

      mkdir -p /opt/waw/bin
      if test -e /opt/waw/bin/waw; then
        grep -qxF '# WAW delegate' /opt/waw/bin/waw
      fi
      printf '%s\n' '#!/bin/sh' '# WAW delegate' 'exec ria --silence --riafile /waw/waw/src/incus/cli/Riafile "$@"' > /opt/waw/bin/waw
      chmod +x /opt/waw/bin/waw
    SH
    FileUtils.mkdir_p(File.expand_path("~/.waw/local-run/#{instance}"), mode: 0o755)
    # 既存の旧 API mount を触らず、通常入室のセッション socket を追加する。
    device = target.fetch("expanded_devices", {})["waw-local-api"]
    expected = { "type" => "disk", "source" => File.expand_path("~/.waw/local-run/#{instance}"), "path" => "/mnt/waw-local-api", "readonly" => "true" }
    raise "未知の入室 API device" if device && device != expected
    sh "incus", "config", "device", "add", instance, "waw-local-api", "disk", "source=#{expected.fetch('source')}", "path=/mnt/waw-local-api", "readonly=true" unless device
    session = SecureRandom.hex(3)
    listener = Socket.new(:UNIX, :SEQPACKET, 0)
    pid = nil
    begin
      listener.bind(Socket.sockaddr_un(File.expand_path("~/.waw/local-run/#{instance}/#{session}")))
      File.chmod(0o600, File.expand_path("~/.waw/local-run/#{instance}/#{session}"))
      listener.listen(8)
      shell = <<~'SH'
        export SHELL=/bin/bash
        export PATH="/opt/waw/bin:/root/.local/share/mise/shims:/root/.local/bin:$PATH"
        waw() {
          local code=0
          command waw "$@" || code=$?
          if [ "$code" = 200 ] && [ "${1-}" != temp ]; then exit 0; fi
          return "$code"
        }
        export -f waw
        exec /bin/bash
      SH
      puts "local supervisor: #{instance}:#{cwd}"; $stdout.flush
      pid = Process.spawn("incus", "exec", "local:#{instance}", "--force-interactive", "--cwd", cwd, "--env", "WAW_SOCKET=/mnt/waw-local-api/#{session}", "--", "bash", "-c", shell)
      transition = nil
      next_input = nil
      loop do
        if (finished = Process.waitpid2(pid, Process::WNOHANG))
          pid = nil
          exit(finished.last.exitstatus || 1)
        end
        next unless IO.select([listener], nil, nil, 0.1)
        peer, = listener.accept
        inputs = []
        begin
          _peer_pid, uid, = peer.getsockopt(:SOCKET, :PEERCRED).to_s.unpack("i!3")
          # この環境の root は既存の raw.idmap で WSL ユーザーへ対応する。
          raise "許可されていない socket UID" unless uid == Process.uid && target.fetch("expanded_config").fetch("raw.idmap", "").lines.any? { _1.split == ["uid", Process.uid.to_s, "0"] }
          data, _addr, flags, *controls = peer.recvmsg(65536, 0, nil, scm_rights: true)
          inputs = controls.select { _1.cmsg_is?(:SOCKET, :RIGHTS) }.flat_map(&:unix_rights)
          raise "要求が長すぎます" unless (flags & (Socket::MSG_TRUNC | Socket::MSG_CTRUNC)).zero?
          request = JSON.parse(data)
          if request['op'] == 'temp'
            raise "temp は stdin/stdout/stderr が必要です" unless inputs.size == 3
          else
            raise "stdin は regular file 1つだけです" unless inputs.size <= 1 && inputs.all? { _1.stat.file? }
          end
          raise "不正な要求" unless request.keys.sort == %w[args cwd op] && request["args"].is_a?(Array) && request["args"].all? { _1.is_a?(String) && !_1.include?("\0") }
          raise "不正な cwd" unless request["cwd"].is_a?(String) && request["cwd"].start_with?("/") && !request["cwd"].include?("\0") && File.expand_path(request["cwd"]) == request["cwd"]
          op = request.fetch("op")
          raise "未知の操作" unless %w[new add fork bash done pwsh drop temp list].include?(op)
          raise "fork [--bash]" if op == "fork" && ![[], ["--bash"]].include?(request.fetch("args"))
          raise "done [--keep]" if op == "done" && ![[], ["--keep"]].include?(request.fetch("args"))
          raise "不正な project 引数" if %w[new add].include?(op) && (request.fetch("args").size != 1 || request.fetch("args").first.match?(/\A(?:instance|cwd)=/))
          if op == 'temp'
            raise 'temp <cmd> [args...]' if request.fetch('args').empty?
            # guest の FD をそのまま渡す。出力のポンプや試験用 PTY は作らない。
            worker = Process.spawn({ 'RIA_SILENCE' => '1', 'WAW_TEMP_ARGS' => JSON.generate(request.fetch('args')) }, RbConfig.ruby, $PROGRAM_NAME, '--riafile', "#{state.fetch('rootfs')}/waw/waw/src/wsl/Riafile", 'local', 'temp', "instance=#{instance}", "cwd=#{request.fetch('cwd')}", in: inputs[0], out: inputs[1], err: inputs[2], pgroup: true)
            begin
              loop do
                if (finished = Process.waitpid2(worker, Process::WNOHANG))
                  worker = nil
                  peer.sendmsg(JSON.generate('status' => 'succeeded', 'exit_code' => finished.last.exitstatus || 128 + finished.last.termsig))
                  break
                end
                if IO.select([peer], nil, nil, 0.1)
                  # cancel 要求 / 呼出し元の切断は worker の ensure cleanup を起動する。
                  cancellation, = peer.recvmsg(4096)
                  signal = cancellation.empty? ? 'TERM' : JSON.parse(cancellation).fetch('signal')
                  raise '不正な中断 signal' unless %w[INT TERM HUP].include?(signal)
                  Process.kill(signal, worker)
                  _, result = Process.waitpid2(worker)
                  worker = nil
                  peer.sendmsg(JSON.generate('status' => 'succeeded', 'exit_code' => result.exitstatus || 128 + result.termsig))
                  break
                end
              end
            ensure
              if worker
                Process.kill('TERM', worker) rescue nil
                Process.waitpid(worker) rescue nil
              end
            end
            next
          end
          if op == "pwsh"
            ps = `command -v pwsh.exe || command -v powershell.exe`.strip
            raise "pwsh.exe / powershell.exe がありません" unless $?.success? && !ps.empty?
            mount = target.fetch("expanded_devices").values.select { _1["type"] == "disk" && _1["path"] != "/" && _1["source"].to_s.start_with?("/") && (request.fetch("cwd") == _1["path"] || request.fetch("cwd").start_with?(_1["path"] + "/")) }.max_by { _1.fetch("path").size }
            state["ps_cwd"] = mount ? mount.fetch("source") + request.fetch("cwd").delete_prefix(mount.fetch("path")) : state.fetch("rootfs") + request.fetch("cwd")
            unc = `wslpath -w #{Shellwords.escape(state.fetch('ps_cwd'))}`.strip
            raise "UNC 変換失敗" unless $?.success? && unc.start_with?("\\\\")
            script = <<~PS
              $ErrorActionPreference = 'Stop'
              [Console]::InputEncoding = [Console]::OutputEncoding = [Text.UTF8Encoding]::new()
              $OutputEncoding = [Console]::OutputEncoding
              Set-Location -LiteralPath '#{unc.gsub("'", "''")}'
            PS
            script += "& " + request.fetch("args").map { "'#{_1.gsub("'", "''")}'" }.join(" ") + "\n" unless request.fetch("args").empty?
            # -Command で起動し、Windows 本体の寿命を interop / 子の EOF と分離する。
            arguments = %Q{-NoLogo -NoProfile #{request.fetch('args').empty? ? '-NoExit' : ''} -Command "& ([ScriptBlock]::Create([Text.Encoding]::Unicode.GetString([Convert]::FromBase64String('#{[script.encode("UTF-16LE")].pack("m0")}'))))"}
            state["ps_exit"] = File.expand_path("~/.waw/local-run/#{instance}/#{session}-ps-#{SecureRandom.hex(3)}.exit")
            completion_unc = `wslpath -w #{Shellwords.escape(state.fetch('ps_exit'))}`.strip
            raise "終了通知の UNC 変換失敗" unless $?.success?
            controller = <<~PS
              $ErrorActionPreference = 'Stop'
              try {
                $start = New-Object Diagnostics.ProcessStartInfo
                $start.FileName = (Get-Process -Id $PID).Path
                $start.UseShellExecute = $false
                $start.Arguments = '#{arguments.gsub("'", "''")}'
                $shell = [Diagnostics.Process]::Start($start)
                $shell.WaitForExit()
                $result = [string]$shell.ExitCode
              } catch {
                $result = 'error: ' + $_
              }
              [IO.File]::WriteAllText('#{completion_unc.gsub("'", "''")}.tmp', $result)
              [IO.File]::Move('#{completion_unc.gsub("'", "''")}.tmp', '#{completion_unc.gsub("'", "''")}')
            PS
            command = %q{SYSTEM:exec \"$WAW_PS_EXE\" -NoLogo -NoProfile -Command \"$WAW_PS_COMMAND\",pty,setsid,ctty,stderr}
            relay = nil
            begin
              relay = Process.spawn({ "WAW_PS_EXE" => ps, "WAW_PS_COMMAND" => controller }, "socat", "UNIX-LISTEN:#{File.expand_path("~/.waw/local-run/#{instance}/#{session}-ps")},mode=0600", command)
              until File.socket?(File.expand_path("~/.waw/local-run/#{instance}/#{session}-ps"))
                raise "PowerShell relay 起動失敗" if Process.waitpid(relay, Process::WNOHANG)
                sleep 0.05
              end
              peer.sendmsg(JSON.generate("status" => "progress", "socket" => "/mnt/waw-local-api/#{session}-ps"))
              until File.file?(state.fetch("ps_exit"))
                if (finished = Process.waitpid2(relay, Process::WNOHANG))
                  relay = nil
                  raise "PowerShell 終了通知なし: #{finished.last}" unless File.file?(state.fetch("ps_exit"))
                end
                sleep 0.05
              end
              # 143 は監視による意図した切断。本体の終了コードを判定する。
              if relay
                Process.kill("TERM", relay)
                Process.waitpid(relay)
                relay = nil
              end
              completion = File.read(state.fetch("ps_exit"))
              raise "PowerShell 失敗: #{completion}" unless completion == "0"
              File.unlink(state.fetch("ps_exit"))
            ensure
              if relay
                Process.kill("TERM", relay) rescue nil
                Process.waitpid(relay) rescue nil
              end
              File.unlink(File.expand_path("~/.waw/local-run/#{instance}/#{session}-ps")) if File.socket?(File.expand_path("~/.waw/local-run/#{instance}/#{session}-ps"))
            end
            peer.sendmsg(JSON.generate("status" => "succeeded"))
            next
          end
          if op == 'drop' && (request.fetch('args').empty? || request.fetch('args') == [instance])
            raise '大元 waw は削除できません' if instance == 'waw'
            output, result = Open3.capture2e({ 'RIA_SILENCE' => '1', 'WAW_DROP_CHECK' => '1' }, 'ria', '--riafile', "#{state.fetch('rootfs')}/waw/waw/src/wsl/Riafile", 'local', 'drop', instance)
            raise output unless result.success?
            transition = { 'instance' => 'waw', 'drop' => true }
          elsif op == "bash"
            refreshed = `incus list local: --format=json`
            raise "instance 一覧取得失敗" unless $?.success?
            owned = JSON.parse(refreshed).select { _1["type"] == "container" && _1.fetch("expanded_config", {}).values_at("user.waw.owner", "user.waw.home", "security.privileged") == ["waw-incus-v1", File.expand_path("~/.waw"), "false"] }
            if request.fetch("args").empty?
              peer.sendmsg(JSON.generate("status" => "progress", "choices" => owned.map { _1.fetch("name") }))
              selection, = peer.recvmsg(4096)
              chosen = JSON.parse(selection).fetch("id")
            else
              chosen = request.fetch("args").fetch(0)
            end
            raise "WAW 所有の環境ではありません: #{chosen}" unless owned.any? { _1["name"] == chosen }
            transition = { "instance" => chosen }
          else
            output, result = Open3.capture2e({ "RIA_SILENCE" => "1" }, "ria", "--riafile", "#{state.fetch('rootfs')}/waw/waw/src/wsl/Riafile", "local", op, "instance=#{instance}", "cwd=#{request.fetch('cwd')}", *request.fetch("args").reject { _1 == "--bash" })
            output.each_line { peer.sendmsg(JSON.generate("status" => "progress", "message" => _1.chomp)) unless _1.start_with?("WAW_RESULT=") }
            raise "#{op} 失敗（上の診断を確認してください）" unless result.success?
            record = output.lines.find { _1.start_with?("WAW_RESULT=") }
            transition = JSON.parse(record.delete_prefix("WAW_RESULT=")) if record && (op == "done" || request.fetch("args").include?("--bash"))
          end
          if transition
            destination = owned.find { _1['name'] == transition.fetch('instance') }
            destination_pool = destination ? destination.fetch('expanded_devices').fetch('root').fetch('pool') : pool
            destination_root = "/var/lib/incus/storage-pools/#{destination_pool}/containers/#{transition.fetch('instance')}/rootfs"
            transition['cwd'] = File.directory?(destination_root + request.fetch('cwd')) ? request.fetch('cwd') : '/waw/waw'
          end
          peer.sendmsg(JSON.generate("status" => "succeeded", "transition" => !!transition))
          if transition
            next_input = inputs.shift
            _, result = Process.waitpid2(pid); pid = nil
            raise "Bash が正常終了しませんでした" unless result.success?
            break
          end
        rescue StandardError => error
          warn error.full_message
          peer.sendmsg(JSON.generate("status" => "failed", "reason" => error.message)) rescue nil
        ensure
          inputs.each(&:close)
          peer.close
        end
      end
    ensure
      listener.close
      File.unlink(File.expand_path("~/.waw/local-run/#{instance}/#{session}")) if File.socket?(File.expand_path("~/.waw/local-run/#{instance}/#{session}"))
    end
    if transition["delete"]
      # Bash の終了後にも確認し、統合中の変更を削除しない。
      sh "bash", "-euo", "pipefail", "-c", <<~'SH', "waw-before-delete", "#{state.fetch('rootfs')}/waw", instance
        for repo in "$1"/*; do
          test "${repo##*/}" != waw-root || continue
          test -e "$repo/.git" || test -L "$repo/.git" || continue
          test ! -L "$repo" && test ! -L "$repo/.git" && test -d "$repo/.git"
          status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
          test -z "$status"
          head=$(git -C "$repo" rev-parse HEAD)
          submitted=$(git -C "$repo" rev-parse "refs/waw/done/$2")
          test "$head" = "$submitted"
        done
      SH
    end
    if transition['delete'] || transition['drop']
      code = sh 'ria', '--riafile', 'Riafile', 'local', 'drop', instance, env: { 'WAW_DROP_UUID' => target.fetch('expanded_config').fetch('volatile.uuid'), 'WAW_DROP_RETAIN' => transition['delete'] ? '1' : '0' }, abort: false
      raise 'drop 失敗: 環境と診断を確認してください' if code != 0
    end
    sh "ria", "--riafile", "Riafile", "local", "bash", transition.fetch("instance"), "cwd=#{transition.fetch('cwd')}", env: { "WAW_LOCAL_SELECT" => "0" } unless next_input
    if next_input
      command = ["ria", "--riafile", "Riafile", "local", "bash", transition.fetch("instance"), "cwd=#{transition.fetch('cwd')}"]
      child = Process.spawn({ "WAW_LOCAL_SELECT" => "0" }, *command, in: next_input)
      next_input.close
      _, result = Process.waitpid2(child)
      exit(result.exitstatus || 1)
    end
    next
  end

  FileUtils.mkdir_p(File.expand_path("~/.waw/local-run"), mode: 0o755)
  stat = File.lstat(File.expand_path("~/.waw/local-run"))
  raise "未知の local-run directory" unless stat.directory? && stat.uid == Process.uid && (stat.mode & 0o022).zero?
  # temp は子作成中の中断にも ensure を通す。cleanup 中の再割込みは無視する。
  signals = {}
  if operation == 'temp'
    raise 'temp <cmd> [args...]' if args.empty?
    cancelled = nil
    # copy / start を途中で見失わない。準備完了まで中断を記録してから cleanup。
    %w[INT TERM HUP].each { |signal| signals[signal] = Signal.trap(signal) { cancelled ||= signal } }
  end
  begin
  File.open(File.expand_path("~/.waw/local-run/lock"), File::RDWR | File::CREAT, 0o600) do |lock|
    raise "別の WAW local 操作が実行中です" unless lock.flock(File::LOCK_EX | File::LOCK_NB)
    case operation
    when "new", "add"
      raise "#{operation} <#{operation == 'new' ? 'name' : 'URL'}>" unless args.size == 1
      parent = owned.find { _1["name"] == "waw" }
      raise "親 waw がありません" unless parent
      sh "incus", "exec", "local:waw", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH', "waw-project", operation, args.fetch(0)
        cd /waw
        if test "$1" = new; then
          case "$2" in ''|.*|*/*|waw-root) echo '不正な project 名' >&2; exit 1;; esac
          mkdir -- "$2"
          git -C "$2" init --initial-branch=main
          git -C "$2" -c user.name=WAW -c user.email=waw@localhost commit --allow-empty -m 'Initial commit'
        else
          name=${2%/}; name=${name##*/}; name=${name%.git}
          case "$name" in .*|waw-root) echo '予約された project 名' >&2; exit 1;; esac
          git clone -- "$2"
        fi
      SH
    when 'drop'
      raise 'drop [ID]' unless args.empty?
      raise '大元 waw は削除できません' if instance == 'waw'
      storage = `incus storage list local: --format=json`
      raise 'storage 一覧取得失敗' unless $?.success?
      raise '削除対象の pool が WAW 所有の利用可能な Btrfs ではありません' unless JSON.parse(storage).any? { _1['name'] == pool && _1['driver'] == 'btrfs' && _1['status'] == 'Created' && _1.fetch('config', {})['user.waw.owner'] == 'waw-incus-v1' }
      uuid = target.fetch('expanded_config').fetch('volatile.uuid')
      raise '削除前に環境の UUID が変わりました' if ENV['WAW_DROP_UUID'] && ENV['WAW_DROP_UUID'] != uuid
      dependencies = `incus list local: --all-projects --format=json`
      raise '全 project 依存一覧取得失敗' unless $?.success?
      dependents = JSON.parse(dependencies).select do |row|
        row.fetch('expanded_config', {})['user.waw.parent'] == instance || row.fetch('expanded_devices', {}).values.any? { _1['type'] == 'disk' && (_1['source'] == state.fetch('rootfs') || _1['source'].to_s.start_with?(state.fetch('rootfs') + '/')) }
      end
      unless dependents.empty?
        reason = "保持 #{instance}: 子孫 / mount 依存 #{dependents.map { _1.fetch('name') }.join(', ')}"
        if ENV['WAW_DROP_RETAIN'] == '1'
          puts reason
          next
        end
        raise reason
      end
      refreshed = `incus list local: --format=json`
      raise '削除前の instance 一覧取得失敗' unless $?.success?
      current = JSON.parse(refreshed).find { _1['name'] == instance }
      raise '削除前に環境の所有 / UUID が変わりました' unless current && current.fetch('expanded_config', {}).values_at('user.waw.owner', 'user.waw.home', 'security.privileged', 'volatile.uuid') == target.fetch('expanded_config').values_at('user.waw.owner', 'user.waw.home', 'security.privileged', 'volatile.uuid')
      next if ENV['WAW_DROP_CHECK'] == '1'
      sh 'incus', 'delete', "local:#{instance}", '--force'
      puts "削除 #{instance}"
    when "fork", "temp"
      raise "fork [--bash]" if operation == 'fork' && ![[], ["--bash"]].include?(args)
      name = "waw-#{Time.now.utc.strftime('%Y%m%d-%H%M%S')}-#{SecureRandom.hex(3)}"
      raise "同名 instance が存在します" if instances.any? { _1["name"] == name }
      storage = `incus storage list local: --format=json`
      raise "storage 一覧取得失敗" unless $?.success?
      raise "Btrfs pool が必要です" unless JSON.parse(storage).any? { _1["name"] == pool && _1["driver"] == "btrfs" }
      origin = owned.find { _1["name"] == "waw" }
      raise "大元 waw がありません" unless origin
      origin_pool = origin.fetch("expanded_devices").fetch("root").fetch("pool")
      raise "不正な大元 pool 名" unless origin_pool.match?(/\A[a-zA-Z0-9-]+\z/)
      origin_rootfs = "/var/lib/incus/storage-pools/#{origin_pool}/containers/waw/rootfs"
      parent_device = target.fetch("expanded_devices", {})["waw-parent"]
      if parent_device
        raise "未知の waw-parent device 設定" unless parent_device["type"] == "disk" && (parent_device.keys - %w[type source path readonly]).empty?
      end
      # 分岐点は copy に含まれた HEAD。複製元と提出先は別。
      state['temporary'] = name if operation == 'temp'
      sh "incus", "copy", "local:#{instance}", "local:#{name}", "--instance-only", "--stateless", "--config", "user.waw.temp=#{operation == 'temp'}",
         "--config", "user.waw.parent=#{instance}", "--config", "user.waw.local=13",
         "--device", "waw-parent,type=disk", "--device", "waw-parent,source=#{origin_rootfs}/waw",
         "--device", "waw-parent,path=/waw/waw-root", "--device", "waw-parent,readonly=true"
      sh "incus", "config", "device", "remove", name, "waw-local-api" if target.fetch("expanded_devices", {}).key?("waw-local-api")
      sh "incus", "start", "local:#{name}"
      sh "incus", "exec", "local:#{name}", "--disable-stdin", "--", "bash", "-eu", "-c", <<~'SH', "waw-fork", name
        for repo in /waw/*; do
          test "$repo" != /waw/waw-root || continue
          test -d "$repo/.git" || continue
          for state in CHERRY_PICK_HEAD MERGE_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer index.lock; do
            test ! -e "$(git -C "$repo" rev-parse --path-format=absolute --git-path "$state")" || { echo "Git 操作中: $repo $state"; exit 1; }
          done
          git -C "$repo" update-ref "refs/waw/start/$1" HEAD
          # 複製元だけにある実験 repo と、大元から後で消えた repo を区別する。
          if test ! -e "/waw/waw-root/${repo##*/}/.git"; then
            git -C "$repo" update-ref "refs/waw/absent-root/$1" HEAD
          fi
          if test -n "$(git -C "$repo" status --porcelain=v1 --untracked-files=all)"; then
            git -C "$repo" add -A
            git -C "$repo" -c user.name=WAW -c user.email=waw@localhost commit -m 'WAW inherited working tree'
          fi
        done
      SH
      puts "waw bash #{name}"
      puts "WAW_RESULT=#{JSON.generate('instance' => name)}"
      state["created"] = name
    when "done"
      raise "done [--keep]" unless [[], ["--keep"]].include?(args)
      raise "親では done を実行できません" if instance == "waw"
      raise "13 の fork で作った子ではありません" unless target.fetch("expanded_config")["user.waw.local"] == "13"
      parent = owned.find { _1["name"] == "waw" }
      raise "大元 waw が起動していません" unless parent && parent["status"] == "Running"
      parent_pool = parent.fetch('expanded_devices').fetch('root').fetch('pool')
      raise "不正な大元 pool 名" unless parent_pool.match?(/\A[a-zA-Z0-9-]+\z/)
      state["parent_rootfs"] = "/var/lib/incus/storage-pools/#{parent_pool}/containers/waw/rootfs"
      storage = `incus storage list local: --format=json`
      raise "storage 一覧取得失敗" unless $?.success?
      pools = JSON.parse(storage)
      raise "提出元 / 大元の pool が WAW 所有の利用可能な Btrfs ではありません" unless [pool, parent_pool].all? { |name| pools.any? { _1['name'] == name && _1['driver'] == 'btrfs' && _1['status'] == 'Created' && _1.fetch('config', {})['user.waw.owner'] == 'waw-incus-v1' } }
      dependencies = `incus list local: --all-projects --format=json`
      raise "全 project 依存一覧取得失敗" unless $?.success?
      reasons = JSON.parse(dependencies).filter_map do |row|
        if row.fetch('expanded_config', {})['user.waw.parent'] == instance
          "子孫: #{row.fetch('name')}"
        elsif row.fetch('expanded_devices', {}).values.any? { _1['type'] == 'disk' && (_1['source'] == state.fetch('rootfs') || _1['source'].to_s.start_with?(state.fetch('rootfs') + '/')) }
          "旧 mount 依存: #{row.fetch('name')}"
        end
      end
      reasons << '--keep 指定' if args == ['--keep']
      reasons.each { puts "保持 #{instance}: #{_1}" }
      # Git は rootfs の通常 repo をパス指定で取得。remote 設定・共有 bare は参照しない。
      sh "bash", "-euo", "pipefail", "-c", <<~'SH', "waw-done-local", "#{state.fetch('rootfs')}/waw", "#{state.fetch('parent_rootfs')}/waw", instance, reasons.empty?.to_s
        child=$1; parent=$2; id=$3; delete=$4
        repos=()
        trap 'code=$?; if test "$code" != 0; then echo "done 失敗: 環境=$id 提出元=$child/${name:-<repo>} 統合先=$parent/${name:-<repo>} 基準=${start:-未取得} 大元基準=${base:-未取得}。提出準備の競合解消場所は子 /waw/${name:-<repo>}（waw-submit/$id）。git status を確認し、解消して git add / git cherry-pick --continue 後、通常 waw done を再実行。大元の既存 Git 操作・dirty は別途状態確認が必要です。自動変更しません。" >&2; fi' EXIT
        # 開始 ref と大元の両方がある repo だけ提出する。対象外は触らない。
        for repo in "$child"/*; do
          test "${repo##*/}" != waw-root || continue
          test -e "$repo/.git" || test -L "$repo/.git" || continue
          test ! -L "$repo" && test ! -L "$repo/.git" && test -d "$repo/.git" || { echo "通常の repo が必要です: $repo"; exit 1; }
          if git -C "$repo" show-ref --verify --quiet "refs/waw/start/$id"; then
            dest="$parent/${repo##*/}"
            if test ! -e "$dest/.git" && test ! -L "$dest/.git"; then
              if git -C "$repo" show-ref --verify --quiet "refs/waw/absent-root/$id"; then
                echo "対象外 ${repo##*/}: fork 時から大元にない repo"
                echo "保持 $id: 対象外 repo ${repo##*/}"
                delete=false
                continue
              else
                code=$?; test "$code" = 1 || exit "$code"
                echo "fork 時の repo が大元から消えています（旧環境では元の存在を確認できません）: $dest"; exit 1
              fi
            fi
            repos+=("${repo##*/}")
          else
            code=$?; test "$code" = 1 || exit "$code"
            echo "対象外 ${repo##*/}: この環境の開始 ref がありません"
            echo "保持 $id: 対象外 repo ${repo##*/}"
            delete=false
          fi
        done
        for dest in "$parent"/*; do
          test "${dest##*/}" != waw-root || continue
          test -e "$dest/.git" || continue
          test -e "$child/${dest##*/}/.git" || echo "対象外 ${dest##*/}: 子に repo / 開始 ref がありません"
        done
        export GIT_AUTHOR_NAME=WAW GIT_AUTHOR_EMAIL=waw@localhost GIT_COMMITTER_NAME=WAW GIT_COMMITTER_EMAIL=waw@localhost
        # 全対象の dirty / Git 操作・提出範囲を、最初の統合より前に検査する。
        for name in "${repos[@]}"; do
          repo="$child/$name"; dest="$parent/$name"
          start=$(git -C "$repo" rev-parse --verify "refs/waw/start/$id^{commit}")
          if git -C "$dest" show-ref --verify --quiet "refs/waw/$id/submitted"; then
            start=$(git -C "$dest" rev-parse "refs/waw/$id/submitted")
          else
            code=$?; test "$code" = 1 || exit "$code"
          fi
          base=$(git -C "$dest" rev-parse HEAD)
          raw=HEAD
          if git -C "$repo" symbolic-ref -q "refs/waw/prepare/$id/original" >/dev/null; then
            raw="refs/waw/prepare/$id/raw"
            test "$(git -C "$repo" symbolic-ref HEAD)" = "refs/heads/waw-submit/$id" || { echo "提出準備 branch に戻ってください: $id $repo waw-submit/$id"; exit 1; }
          fi
          git -C "$repo" merge-base --is-ancestor "$start" "$raw" || { echo "提出済み / 開始 ref が HEAD の祖先ではありません: $repo"; exit 1; }
          for repo in "$repo" "$dest"; do
            test ! -L "$repo" && test ! -L "$repo/.git" && test -d "$repo/.git" || { echo "通常の repo が必要です: $repo"; exit 1; }
            git -C "$repo" symbolic-ref -q HEAD >/dev/null || { echo "branch が必要です: $repo"; exit 1; }
            dirty=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
            test -z "$dirty" || { echo "dirty: $repo 環境=$id 提出元=$child/$name 統合先=$dest 基準=$start。提出準備中なら子 /waw/$name の競合を解消・commit して waw done を再実行（大元は変更しない）"; exit 1; }
            for status in CHERRY_PICK_HEAD MERGE_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer index.lock; do
              path=$(git -C "$repo" rev-parse --path-format=absolute --git-path "$status")
              test ! -e "$path" || { echo "Git 操作中: $repo $status"; exit 1; }
            done
          done
        done
        for name in "${repos[@]}"; do
          repo="$child/$name"; dest="$parent/$name"
          start=$(git -C "$repo" rev-parse "refs/waw/start/$id")
          if git -C "$dest" show-ref --verify --quiet "refs/waw/$id/submitted"; then
            start=$(git -C "$dest" rev-parse "refs/waw/$id/submitted")
          else
            code=$?; test "$code" = 1 || exit "$code"
          fi
          prep="refs/waw/prepare/$id"
          branch="waw-submit/$id"
          if git -C "$repo" symbolic-ref -q "$prep/original" >/dev/null; then
            head=$(git -C "$repo" rev-parse "$prep/raw")
          else
            head=$(git -C "$repo" rev-parse HEAD)
          fi
          # 大元の最新を子へ取得する。統合・競合解消は書き込み可能な子だけで行う。
          git -C "$repo" fetch --quiet --no-tags --no-write-fetch-head "$dest" "+HEAD:$prep/latest"
          # 今回の提出に必要な HEAD / 開始点だけ取得する。
          # refs/waw/* の丸ごと取得は archive を再帰コピーして増殖させるため行わない。
          git -C "$dest" fetch --quiet --no-tags --no-write-fetch-head "$repo" "+$head:refs/waw/$id/raw" "+refs/waw/start/$id:refs/waw/$id/start"
          if test "$start" = "$head"; then
            git -C "$dest" update-ref "refs/waw/$id/submitted" "$head"
            git -C "$repo" update-ref "refs/waw/done/$id" "$head"
            if original=$(git -C "$repo" symbolic-ref -q "$prep/original"); then
              git -C "$repo" switch "${original#refs/heads/}"
              git -C "$repo" symbolic-ref --delete "$prep/original"
              git -C "$repo" branch -D "$branch"
            fi
            continue
          fi
          tree=$(git -C "$repo" rev-parse "$head^{tree}")
          # 元の提出 HEAD で再実行を識別する。旧実装の決定的 squash trailer も照合する。
          export GIT_AUTHOR_DATE=$(git -C "$repo" show -s --format=%aI "$head")
          export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
          squash=$(printf 'WAW squash %s (%s)\n\n' "$id" "${repo##*/}"; git -C "$repo" log --format='%h %s' "$start..$head")
          legacy=$(printf '%s\n' "$squash" | git -C "$repo" commit-tree "$tree" -p "$start")
          squash=$(printf '%s\n\nWAW-Squash: %s\n' "$squash" "$head" | git -C "$repo" commit-tree "$tree" -p "$start")
          git -C "$repo" update-ref "$prep/squash" "$squash"
          merged=$(git -C "$dest" log --format=%H --fixed-strings --grep="WAW-Squash: $head" --grep="WAW-Squash: $legacy" HEAD -1)
          if test -z "$merged"; then
            if ! git -C "$repo" symbolic-ref -q "$prep/original" >/dev/null; then
              if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
                echo "既存 branch を上書きしません: $repo $branch"; exit 1
              fi
              original=$(git -C "$repo" symbolic-ref HEAD)
              git -C "$repo" update-ref "$prep/raw" "$head"
              git -C "$repo" update-ref "$prep/base" "$prep/latest"
              git -C "$repo" symbolic-ref "$prep/original" "$original"
              git -C "$repo" switch -c "$branch" "$prep/base"
              base=$(git -C "$repo" rev-parse "$prep/base")
              git -C "$repo" cherry-pick "$squash"
            fi
            base=$(git -C "$repo" rev-parse "$prep/base")
            candidate=$(git -C "$repo" rev-parse HEAD)
            test "$(git -C "$repo" rev-list --parents -n 1 HEAD)" = "$candidate $base" || { echo "子の提出 branch は大元基準 $base 上の1 commit に完成させてください: $repo"; exit 1; }
            latest=$(git -C "$repo" rev-parse "$prep/latest")
            # 提出済み直後の中断は再適用せず、記録更新へ進む。
            if ! git -C "$repo" merge-base --is-ancestor "$candidate" "$latest"; then
              if test "$base" != "$latest"; then
                # 前回解消済みの成果も保全し、進んだ大元に子側で再適用する。
                git -C "$repo" update-ref "$prep/candidate" "$candidate"
                git -C "$repo" update-ref "$prep/base" "$latest"
                git -C "$repo" switch -C "$branch" "$latest"
                base=$latest
                git -C "$repo" cherry-pick "$candidate"
                candidate=$(git -C "$repo" rev-parse HEAD)
              fi
              git -C "$dest" fetch --quiet --no-tags --no-write-fetch-head "$repo" "+HEAD:refs/waw/$id/prepared"
              # 大元がさらに進んでも上書き・大元での競合解消はしない。
              git -C "$dest" merge --ff-only "refs/waw/$id/prepared"
            fi
            merged=$candidate
          fi
          git -C "$dest" update-ref "refs/waw/$id/merged" "$merged"
          git -C "$dest" update-ref "refs/waw/$id/submitted" "$head"
          git -C "$repo" update-ref "refs/waw/done/$id" "$head"
          if original=$(git -C "$repo" symbolic-ref -q "$prep/original"); then
            git -C "$repo" switch "${original#refs/heads/}"
            git -C "$repo" symbolic-ref --delete "$prep/original"
            git -C "$repo" branch -D "$branch"
          fi
        done
        printf 'WAW_RESULT={"instance":"waw","delete":%s}\n' "$delete"
      SH
    else
      raise "未知の操作: #{operation}"
    end
  end
  if operation == 'temp'
    %w[INT TERM HUP].each { |signal| Signal.trap(signal) { raise SignalException, signal } }
    raise SignalException, cancelled if cancelled
    code = sh 'incus', 'exec', "local:#{state.fetch('created')}", ($stdin.tty? ? '--force-interactive' : '--force-noninteractive'), '--cwd', cwd, '--', 'env', 'PATH=/opt/waw/bin:/root/.local/share/mise/shims:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin', *args, abort: false
    exit code
  end
  ensure
    if operation == 'temp'
      %w[INT TERM HUP].each { Signal.trap(_1, 'IGNORE') }
      if state['temporary']
        # copy が失敗した場合も、存在確認の成功と所有印を経て drop する。
        remaining = `incus list local: --format=json`
        raise 'temp cleanup 一覧取得失敗（資源を保持）' unless $?.success?
        if (temporary = JSON.parse(remaining).find { _1['name'] == state['temporary'] })
          config = temporary.fetch('expanded_config')
          raise 'temp cleanup: 未知の同名資源を保持' unless config.values_at('user.waw.owner', 'user.waw.home', 'security.privileged', 'user.waw.temp', 'user.waw.parent') == ['waw-incus-v1', File.expand_path('~/.waw'), 'false', 'true', instance]
          code = sh 'ria', '--riafile', 'Riafile', 'local', 'drop', state.fetch('temporary'), env: { 'WAW_DROP_UUID' => config.fetch('volatile.uuid') }, abort: false
          raise "temp cleanup 失敗: #{state.fetch('temporary')} を保持" unless code == 0
        end
      end
      signals.each { |signal, handler| Signal.trap(signal, handler) }
    end
  end
  sh "ria", "--riafile", "Riafile", "local", "bash", state.fetch("created"), "cwd=#{cwd}", env: { "WAW_LOCAL_SELECT" => "0" } if operation == "fork" && args.include?("--bash")
end
