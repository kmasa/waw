require "shellwords"

cmd "install", opt: "[distro=Ubuntu]" do |distro:| # 作成済み親の install を WSL へ委譲
  raise "Windows 上で実行してください" unless windows?
  sh "wsl.exe", "-d", distro, "--exec", "bash", "-e", "-lc",
     'exec ria --riafile "$HOME/.waw/waw/src/wsl/Riafile" install', no_cmd_c: true
end
cmd "status", opt: "[distro=Ubuntu]" do |distro:| # WSL の読み取り専用診断
  raise "Windows 上で実行してください" unless windows?
  sh "wsl.exe", "-d", distro, "--exec", "bash", "-lc", "exec waw status", no_cmd_c: true
end

cmd "herdr", opt: "[distro=Ubuntu]" do |*args, distro:| # Herdr のタブ作成を WSL 経由で Incus へ委譲
  raise "Windows 上で実行してください" unless windows?
  sh "wsl.exe", "-d", distro, "--exec", "bash", "-lc", "exec waw herdr #{args.map { Shellwords.escape(_1) }.join(' ')}", no_cmd_c: true
end

